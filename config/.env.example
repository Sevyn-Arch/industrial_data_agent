# ============================================================
# 工业数据分析 Agent 系统 —— 环境变量模板
# 使用方式：
#   本地开发：复制本文件为 config/.env，按需填写
#       cp config/.env.example config/.env
#   云端部署：不要上传 .env，直接在 Streamlit Cloud 的 Secrets 中填写同名配置
# 说明：程序统一通过 os.getenv 读取，本文件不含任何真实密钥
# ============================================================

# ---------- DeepSeek API 配置（必填项只有 API Key） ----------
# DeepSeek 控制台申请的 API Key；留空时系统自动运行于本地模板模式
DEEPSEEK_API_KEY=
# 兼容 OpenAI 协议的服务地址（不要带 /chat/completions 后缀）
# 官方：https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- 模型配置 ----------
# 代码生成模型 / 报告生成模型（需与所对接服务端实际支持的模型名一致）
CODE_MODEL=deepseek-chat
REPORT_MODEL=deepseek-chat
# 主模型不被支持或返回空内容时自动切换的备选模型
FALLBACK_MODEL=deepseek-v4-pro

# ---------- LLM 调用参数 ----------
# 单次请求超时（秒）
LLM_TIMEOUT=120
# 瞬时错误重试次数
LLM_MAX_RETRIES=3
# 代码生成温度（0 最稳定）/ 报告生成温度
CODE_TEMPERATURE=0.0
REPORT_TEMPERATURE=0.3

# ---------- 代码生成策略 ----------
# true  = 模板优先 + 模糊需求交大模型路由复核（约 100 token/次）
# false = 纯规则判定，零额外额度
TEMPLATE_ROUTER=true

# ---------- 沙箱执行参数 ----------
# 单次执行超时（秒）
SANDBOX_TIMEOUT=60
# 标准输出/错误最大字符数（超出截断）
SANDBOX_MAX_OUTPUT_CHARS=20000
# POSIX 平台地址空间上限（MB，Linux 云环境生效）
SANDBOX_MEMORY_MB=2048

# ---------- 应用参数 ----------
# 日志级别：DEBUG / INFO / WARNING / ERROR
APP_LOG_LEVEL=INFO
# 单个上传文件大小上限（MB）
MAX_UPLOAD_MB=200
